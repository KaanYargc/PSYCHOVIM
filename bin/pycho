#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_DIR="${PSYCHOVIM_DIR:-${PSYCHOVIM_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/nvim}}"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
PSYCHO_HOME="$DATA_HOME/psychovim"
MANAGED_NVIM="$PSYCHO_HOME/neovim/bin/nvim"
NVIM_PATH_FILE="$PSYCHO_HOME/nvim-path"
NVIM_BIN="${PSYCHOVIM_NVIM:-}"
BRANCH="${PSYCHOVIM_BRANCH:-main}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/psychovim"
SETTINGS_FILE="$STATE_HOME/nvim/psychovim/settings.json"
LAZY_ROOT="$DATA_HOME/nvim/lazy"
SYNC_LOG="$CACHE_DIR/lazy-sync.log"
TOOL_LOG="$CACHE_DIR/mason-tools.log"
PARSER_LOG="$CACHE_DIR/parser-sync.log"
STAMP="$(date +%Y%m%d-%H%M%S)"

bold='\033[1m'; red='\033[31m'; green='\033[32m'; yellow='\033[33m'; reset='\033[0m'
say() { printf '%b\n' "$*"; }
die() { say "${red}error:${reset} $*" >&2; exit 1; }

setting_on() {
  local key="$1"
  local default="${2:-true}"
  if [[ -f "$SETTINGS_FILE" ]]; then
    if grep -Eq '"'"$key"'"[[:space:]]*:[[:space:]]*false' "$SETTINGS_FILE"; then return 1; fi
    if grep -Eq '"'"$key"'"[[:space:]]*:[[:space:]]*true' "$SETTINGS_FILE"; then return 0; fi
  fi
  [[ "$default" == "true" ]]
}

tooling_enabled() {
  setting_on lsp true || setting_on formatting true || setting_on linting true
}

resolve_nvim() {
  if [[ -n "$NVIM_BIN" && -x "$NVIM_BIN" ]]; then return 0; fi

  if [[ -f "$NVIM_PATH_FILE" ]]; then
    local recorded
    recorded="$(cat "$NVIM_PATH_FILE" 2>/dev/null || true)"
    if [[ -n "$recorded" && -x "$recorded" ]]; then
      NVIM_BIN="$recorded"
      return 0
    fi
  fi

  if [[ -x "$MANAGED_NVIM" ]]; then
    NVIM_BIN="$MANAGED_NVIM"
    return 0
  fi

  local candidate
  candidate="$(command -v nvim 2>/dev/null || true)"
  if [[ -n "$candidate" && -x "$candidate" ]]; then
    # Never resolve back into a Pycho frontend wrapper.
    if ! grep -q 'PSYCHOVIM nvim frontend' "$candidate" 2>/dev/null; then
      NVIM_BIN="$candidate"
      return 0
    fi
  fi

  die "real nvim binary not found; rerun the PSYCHOVIM installer"
}

migrate_legacy_lockfile() {
  local old="$CONFIG_DIR/lazy-lock.json"
  local new="$STATE_HOME/nvim/psychovim/lazy-lock.json"
  [[ -f "$old" ]] || return 0
  mkdir -p "$(dirname "$new")"
  if [[ ! -f "$new" ]]; then mv "$old" "$new"; else rm -f "$old"; fi
}

filtered_config_status() {
  git -C "$CONFIG_DIR" status --porcelain --untracked-files=all 2>/dev/null \
    | grep -vE '^\?\? lazy-lock\.json$' || true
}

config_dirty() {
  [[ -n "$(filtered_config_status)" ]]
}

repair_plugin_checkout() {
  local name="$1"
  local dir="$LAZY_ROOT/$name"
  local dirty=""
  local backup=""

  [[ -d "$dir/.git" ]] || return 0
  dirty="$(git -C "$dir" status --porcelain 2>/dev/null || true)"
  [[ -n "$dirty" ]] || return 0
  mkdir -p "$CACHE_DIR/dirty-plugins"
  backup="$CACHE_DIR/dirty-plugins/${name}-${STAMP}"
  mv "$dir" "$backup"
  say "plugin repair $name -> $backup"
}

sync_plugins() {
  local attempts="${1:-3}"
  local attempt
  mkdir -p "$CACHE_DIR"
  : > "$SYNC_LOG"
  repair_plugin_checkout "nvim-lspconfig"
  say "plugins      syncing"
  for (( attempt=1; attempt<=attempts; attempt++ )); do
    if PSYCHOVIM_MAINTENANCE=1 "$NVIM_BIN" --headless "+Lazy! sync" "+qa" >>"$SYNC_LOG" 2>&1; then
      say "plugins      ${green}ok${reset}"
      return 0
    fi
    if (( attempt < attempts )); then
      say "plugins      ${yellow}retry $attempt/$attempts${reset}"
      sleep $(( attempt * 2 ))
    fi
  done
  say "plugins      ${yellow}incomplete${reset}"
  say "log          $SYNC_LOG"
  return 1
}

sync_tools() {
  mkdir -p "$CACHE_DIR"
  : > "$TOOL_LOG"
  if ! tooling_enabled; then
    say "tools        off in settings"
    return 0
  fi

  say "tools        syncing"
  if PSYCHOVIM_MAINTENANCE=1 "$NVIM_BIN" --headless "+MasonToolsUpdateSync" "+qa" >>"$TOOL_LOG" 2>&1; then
    say "tools        ${green}ok${reset}"
    return 0
  fi
  say "tools        ${yellow}incomplete${reset}"
  say "log          $TOOL_LOG"
  return 1
}

sync_parsers() {
  mkdir -p "$CACHE_DIR"
  : > "$PARSER_LOG"
  if ! setting_on treesitter true; then
    say "parsers      off in settings"
    return 0
  fi
  if ! command -v tree-sitter >/dev/null 2>&1; then
    say "parsers      skipped (tree-sitter CLI missing)"
    return 0
  fi

  say "parsers      syncing"
  if PSYCHOVIM_MAINTENANCE=1 "$NVIM_BIN" --headless \
    "+lua local ts=require('nvim-treesitter'); local langs={'bash','c','cpp','go','javascript','json','lua','markdown','python','rust','toml','tsx','typescript','vim','vimdoc','yaml'}; for _,lang in ipairs(langs) do ts.install({lang}):wait(300000) end" \
    "+qa" >>"$PARSER_LOG" 2>&1; then
    say "parsers      ${green}ok${reset}"
    return 0
  fi
  say "parsers      ${yellow}incomplete${reset}"
  say "log          $PARSER_LOG"
  return 1
}

update_config_strict() {
  [[ -d "$CONFIG_DIR/.git" ]] || die "$CONFIG_DIR is not a git checkout"
  migrate_legacy_lockfile
  if config_dirty; then
    say "config       ${yellow}dirty${reset}"
    filtered_config_status
    die "refusing to update over local config changes"
  fi

  local before after count
  before="$(git -C "$CONFIG_DIR" rev-parse HEAD)"
  say "config       fetching $BRANCH"
  git -C "$CONFIG_DIR" fetch --prune origin "$BRANCH"
  git -C "$CONFIG_DIR" checkout -q "$BRANCH"
  git -C "$CONFIG_DIR" merge --ff-only "origin/$BRANCH"
  after="$(git -C "$CONFIG_DIR" rev-parse HEAD)"
  if [[ "$before" == "$after" ]]; then
    say "config       ${green}current${reset}"
  else
    count="$(git -C "$CONFIG_DIR" rev-list --count "$before..$after" 2>/dev/null || printf '?')"
    say "config       ${green}${count} commit(s)${reset}"
  fi
}

update_config_soft() {
  if [[ ! -d "$CONFIG_DIR/.git" ]]; then
    say "config       ${yellow}not a git checkout${reset}"
    return 1
  fi

  migrate_legacy_lockfile
  if config_dirty; then
    say "config       ${yellow}local changes; skipped${reset}"
    filtered_config_status
    return 0
  fi

  local before after count
  before="$(git -C "$CONFIG_DIR" rev-parse HEAD 2>/dev/null || true)"
  if ! git -C "$CONFIG_DIR" fetch -q --prune origin "$BRANCH"; then
    say "config       ${yellow}network miss${reset}"
    return 1
  fi
  if ! git -C "$CONFIG_DIR" merge -q --ff-only "origin/$BRANCH"; then
    say "config       ${yellow}not fast-forward; skipped${reset}"
    return 1
  fi
  after="$(git -C "$CONFIG_DIR" rev-parse HEAD 2>/dev/null || true)"
  if [[ "$before" == "$after" ]]; then
    say "config       ${green}current${reset}"
  else
    count="$(git -C "$CONFIG_DIR" rev-list --count "$before..$after" 2>/dev/null || printf '?')"
    say "config       ${green}${count} new commit(s)${reset}"
  fi
}

profile_without_pycho_block() {
  local profile="$1"
  local temp
  [[ -f "$profile" ]] || : > "$profile"
  temp="$(mktemp)"
  awk '
    $0 == "# >>> PSYCHOVIM default editor >>>" { skip=1; next }
    $0 == "# <<< PSYCHOVIM default editor <<<" { skip=0; next }
    !skip { print }
  ' "$profile" > "$temp"
  cat "$temp" > "$profile"
  rm -f "$temp"
}

make_default_editor() {
  local launcher shell_name profile desktop_dir desktop_file rc
  launcher="$(command -v pycho 2>/dev/null || true)"
  [[ -n "$launcher" ]] || launcher="$CONFIG_DIR/bin/pycho"
  [[ -x "$launcher" ]] || die "pycho launcher not found"
  rc=0

  shell_name="$(basename "${SHELL:-bash}")"
  case "$shell_name" in
    zsh) profile="$HOME/.zshrc" ;;
    *) profile="$HOME/.bashrc" ;;
  esac
  profile_without_pycho_block "$profile"
  cat >> "$profile" <<EOF

# >>> PSYCHOVIM default editor >>>
export EDITOR=$(printf '%q' "$launcher")
export VISUAL=$(printf '%q' "$launcher")
# <<< PSYCHOVIM default editor <<<
EOF

  if command -v git >/dev/null 2>&1; then
    git config --global core.editor "$launcher" || rc=1
  fi

  if [[ "$(uname -s)" == "Linux" ]]; then
    desktop_dir="$DATA_HOME/applications"
    desktop_file="$desktop_dir/psychovim.desktop"
    mkdir -p "$desktop_dir"
    cat > "$desktop_file" <<EOF
[Desktop Entry]
Type=Application
Name=PSYCHOVIM
Comment=Pycho text editor
Exec=$launcher %F
TryExec=$launcher
Terminal=true
NoDisplay=true
Categories=Utility;TextEditor;
MimeType=text/plain;
EOF
    if command -v update-desktop-database >/dev/null 2>&1; then
      update-desktop-database "$desktop_dir" >/dev/null 2>&1 || true
    fi
    if command -v xdg-mime >/dev/null 2>&1; then
      xdg-mime default psychovim.desktop text/plain || rc=1
    else
      say "${yellow}default editor:${reset} xdg-mime missing; shell/Git defaults were still set"
      rc=1
    fi
  fi

  if (( rc == 0 )); then
    say "default editor ${green}PSYCHOVIM${reset}"
  else
    say "${yellow}default editor partially configured${reset}"
  fi
  return "$rc"
}

startup_update() {
  [[ "${PSYCHOVIM_NO_AUTOUPDATE:-0}" == "1" ]] && return 0
  local do_config=false do_plugins=false do_parsers=false warning=0
  setting_on auto_update_config true && do_config=true
  setting_on auto_update_plugins true && do_plugins=true
  setting_on auto_update_parsers true && do_parsers=true
  if ! $do_config && ! $do_plugins && ! $do_parsers; then return 0; fi

  resolve_nvim
  say "${red}${bold}pychoUpdater${reset} // CHECK"
  if $do_config; then update_config_soft || warning=1; fi
  if $do_plugins; then
    sync_plugins 1 || warning=1
    sync_tools || warning=1
  fi
  if $do_parsers; then sync_parsers || warning=1; fi
  say ""

  if (( warning == 0 )); then
    export PSYCHOVIM_UPDATER_NOTICE="Config, plugins, tools and parsers are current."
    export PSYCHOVIM_UPDATER_WARNING=0
  else
    export PSYCHOVIM_UPDATER_NOTICE="Update check finished with warnings. See ~/.cache/psychovim/ for logs."
    export PSYCHOVIM_UPDATER_WARNING=1
  fi
}

update_psychovim() {
  resolve_nvim
  command -v git >/dev/null 2>&1 || die "git is required"
  say "${red}${bold}pychoUpdater${reset} // UPDATE"
  update_config_strict

  local rc=0
  sync_plugins 3 || rc=1
  sync_tools || rc=1
  sync_parsers || rc=1
  say ""
  if (( rc == 0 )); then
    say "${green}pychoUpdate complete.${reset}"
  else
    say "${yellow}pychoUpdate completed with warnings.${reset} logs: $CACHE_DIR"
  fi
  return "$rc"
}

show_status() {
  resolve_nvim
  migrate_legacy_lockfile
  say "PSYCHOVIM // STATUS"
  say "nvim         $("$NVIM_BIN" --version | head -n 1)"
  if [[ -d "$CONFIG_DIR/.git" ]]; then
    say "branch       $(git -C "$CONFIG_DIR" branch --show-current)"
    say "commit       $(git -C "$CONFIG_DIR" rev-parse --short HEAD)"
    if config_dirty; then say "config       dirty"; else say "config       clean"; fi
  else
    say "config       missing"
  fi
  setting_on auto_update_config true && say "auto config  on" || say "auto config  off"
  setting_on auto_update_plugins true && say "auto tooling on" || say "auto tooling off"
  setting_on auto_update_parsers true && say "auto parsers on" || say "auto parsers off"
}

show_help() {
  cat <<'EOF'
pycho [file|dir]
pycho update           run pychoUpdate now
pycho settings         open ⚙ Pycho Settings
pycho marketplace      open 󰏗 Pycho Marketplace
pycho status           show install and update state
pycho doctor           open Morning Routine
pycho parsers          sync Treesitter parsers
pycho default-editor   make Pycho the default text editor
pycho help

pychoUpdate and pychoUpdater are installer-provided aliases for `pycho update`.
Every normal launch runs pychoUpdater first and shows the result inside Neovim.
Use PSYCHOVIM_NO_AUTOUPDATE=1 for an emergency no-network boot.
EOF
}

case "${1:-}" in
  update|pychoUpdate|pychoUpdater)
    shift
    update_psychovim "$@"
    ;;
  settings)
    shift
    startup_update
    resolve_nvim
    exec "$NVIM_BIN" "$@" "+PychoSettings"
    ;;
  marketplace)
    shift
    startup_update
    resolve_nvim
    exec "$NVIM_BIN" "$@" "+PychoMarketplace"
    ;;
  status)
    shift
    show_status "$@"
    ;;
  doctor)
    shift
    startup_update
    resolve_nvim
    exec "$NVIM_BIN" "$@" "+MorningRoutine"
    ;;
  parsers)
    shift
    resolve_nvim
    sync_parsers
    ;;
  default-editor)
    shift
    make_default_editor
    ;;
  help|-h|--help)
    show_help
    ;;
  *)
    startup_update
    resolve_nvim
    exec "$NVIM_BIN" "$@"
    ;;
esac
